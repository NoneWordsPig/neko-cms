# 复制成 .env 再填（.env 已被 .gitignore 排除，不会进仓库）
# DeepSeek（或任何兼容 OpenAI 协议的服务）的 API Key
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 站点机器人账号（需 core+ 角色，见站点 docs/comment-bot.md §2.2）
NEKO_USERNAME=neko
NEKO_PASSWORD=change-me

# 可选：站点地址（默认 http://raricy.com:5000）
# RARICY_BASE_URL=http://raricy.com:5000

# 可选：非人类账号名单（逗号分隔），它们发的内容不触发回复
# NEKO_BOT_USERNAMES=neko,NebulaFera,Logos

# 可选：演习模式（只打印不发送）/ 演习时补看历史
# NEKO_DRY_RUN=1
# NEKO_REPLAY_BACKLOG=1
